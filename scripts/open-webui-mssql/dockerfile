FROM ghcr.io/open-webui/open-webui:main

USER root

# Копируем готовый файл утилиты dab в системную папку Linux
COPY dab /usr/bin/dab
RUN chmod +x /usr/bin/dab

# Копируем конфигурационный файл вашей базы данных
COPY dab-config.json /app/backend/dab-config.json

# Команда запуска: сначала mcp-сервер в фоне, затем сам Open WebUI
CMD ["sh", "-c", "dab start --config /app/backend/dab-config.json --no-https-redirect & start.sh"]
